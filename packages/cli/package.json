{
  "name": "@simbiose7/cli",
  "version": "0.4.102",
  "description": "Command line interface for Simbiose7 database connections, schema, and safe queries",
  "keywords": [
    "ai-agent",
    "automation",
    "cli",
    "codex",
    "database",
    "simbiose7",
    "mysql",
    "postgresql",
    "terminal"
  ],
  "homepage": "https://github.com/Mauricio-HNS/Simbiose7/tree/main/packages/cli",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mauricio-HNS/Simbiose7",
    "directory": "packages/cli"
  },
  "bin": {
    "dbx": "bin/dbx.js"
  },
  "files": [
    "bin"
  ],
  "type": "module",
  "scripts": {
    "start": "cargo run -p dbx-cli --no-default-features --",
    "test": "cargo nextest run -p dbx-cli --no-default-features --no-fail-fast",
    "build": "cargo build -p dbx-cli --release --no-default-features",
    "prepublishOnly": "node --check bin/dbx.js"
  },
  "optionalDependencies": {
    "@simbiose7/cli-darwin-arm64": "0.4.102",
    "@simbiose7/cli-darwin-x64": "0.4.102",
    "@simbiose7/cli-linux-arm64-gnu": "0.4.102",
    "@simbiose7/cli-linux-x64-gnu": "0.4.102",
    "@simbiose7/cli-win32-arm64": "0.4.102",
    "@simbiose7/cli-win32-x64": "0.4.102"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
