{
  "name": "@simbiose7/plugin-cli",
  "version": "0.1.9",
  "description": "Create and package Simbiose7 plugins without compiling the Simbiose7 plugin CLI",
  "keywords": [
    "cli",
    "database",
    "simbiose7",
    "plugin",
    "plugin-development"
  ],
  "homepage": "https://github.com/Mauricio-HNS/Simbiose7/tree/main/plugins",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mauricio-HNS/Simbiose7",
    "directory": "packages/plugin-cli"
  },
  "bin": {
    "simbiose7-plugin": "bin/simbiose7-plugin.js"
  },
  "files": [
    "bin",
    "README.md",
    "sdk-root",
    "dev-runtime"
  ],
  "type": "module",
  "scripts": {
    "build": "node --check bin/simbiose7-plugin.js && node --check scripts/stage-sdk.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepack": "node scripts/stage-sdk.mjs && node scripts/stage-dev.mjs",
    "postpack": "node scripts/stage-sdk.mjs --clean && node scripts/stage-dev.mjs --clean",
    "prepublishOnly": "npm run build && npm test"
  },
  "optionalDependencies": {
    "@simbiose7/plugin-cli-darwin-arm64": "0.1.9",
    "@simbiose7/plugin-cli-darwin-x64": "0.1.9",
    "@simbiose7/plugin-cli-linux-arm64-gnu": "0.1.9",
    "@simbiose7/plugin-cli-linux-x64-gnu": "0.1.9",
    "@simbiose7/plugin-cli-win32-arm64": "0.1.9",
    "@simbiose7/plugin-cli-win32-x64": "0.1.9"
  },
  "engines": {
    "node": ">=18.18.0"
  }
}
