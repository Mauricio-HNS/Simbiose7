{
  "name": "@simbiose7/mcp-server",
  "version": "0.4.102",
  "description": "MCP server for Simbiose7 — query databases from Claude Code, Cursor, and other AI agents",
  "keywords": [
    "ai-agent",
    "claude",
    "database",
    "simbiose7",
    "mcp",
    "mysql",
    "postgresql"
  ],
  "homepage": "https://github.com/Mauricio-HNS/simbiose7/tree/main/packages/mcp-server",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mauricio-HNS/simbiose7",
    "directory": "packages/mcp-server"
  },
  "bin": {
    "simbiose7-mcp-server": "bin/simbiose7-mcp-server.js",
    "mcp-server": "bin/simbiose7-mcp-server.js"
  },
  "files": [
    "bin",
    "server.json"
  ],
  "type": "module",
  "scripts": {
    "start": "cargo run -p dbx-mcp --",
    "test": "cargo build -p dbx-mcp && vitest run --config vitest.config.ts",
    "build": "node --check bin/simbiose7-mcp-server.js",
    "prepublishOnly": "node bin/simbiose7-mcp-server.js --verify-platform"
  },
  "optionalDependencies": {
    "@simbiose7/mcp-darwin-arm64": "0.4.102",
    "@simbiose7/mcp-darwin-x64": "0.4.102",
    "@simbiose7/mcp-linux-arm64-gnu": "0.4.102",
    "@simbiose7/mcp-linux-x64-gnu": "0.4.102",
    "@simbiose7/mcp-win32-arm64": "0.4.102",
    "@simbiose7/mcp-win32-x64": "0.4.102"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "mcpName": "io.github.Mauricio-HNS/simbiose7"
}
